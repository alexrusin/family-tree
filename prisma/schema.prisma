// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  ru
}

model User {
  id                String         @id
  email             String         @unique
  name              String
  image             String?
  locale            Locale         @default(en)
  emailVerified     Boolean        @default(false) @map("email_verified")
  createdAt         DateTime       @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime       @map("updated_at") @db.Timestamp(6)
  sessions          Session[]
  accounts          Account[]
  ownedTrees        FamilyTree[]   @relation(name: "OwnedTrees")
  collaboratedTrees Collaborator[] @relation(name: "CollaboratedTrees")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  token     String   @unique
  createdAt DateTime @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @map("updated_at") @db.Timestamp(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @map("updated_at") @db.Timestamp(6)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(6)
}

enum CollaboratorRole {
  editor
  viewer
}

model FamilyTree {
  id            String         @id @default(uuid())
  name          String
  ownerId       String         @map("owner_id")
  owner         User           @relation(name: "OwnedTrees", fields: [ownerId], references: [id], onDelete: Cascade)
  shareToken    String         @unique @map("share_token")
  shareEnabled  Boolean        @default(false) @map("share_enabled")
  memberCount   Int            @default(0) @map("member_count")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)
  collaborators Collaborator[]

  @@index([ownerId])
}

model Collaborator {
  id         String           @id @default(uuid())
  treeId     String           @map("tree_id")
  tree       FamilyTree       @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId     String           @map("user_id")
  user       User             @relation(name: "CollaboratedTrees", fields: [userId], references: [id], onDelete: Cascade)
  role       CollaboratorRole
  invitedAt  DateTime         @default(now()) @map("invited_at") @db.Timestamp(6)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamp(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([treeId, userId])
  @@index([userId])
  @@index([treeId])
}
